{
    "name": "erikwestlund/phibble",
    "description": "A typed, immutable in-memory data frame for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*"
    },
    "require-dev": {
        "erikwestlund/phit": "dev-main",
        "illuminate/database": "^12.0",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Used by the test suite for the PDO source",
        "illuminate/database": "Laravel integration: Collection::toFrame() and query builder ->phibble() / ->toFrame() macros (auto-discovered)",
        "ext-php_polars": "The Polars backend (Phibble\\Polars\\PolarsTable), from erikwestlund/phpolars"
    },
    "autoload": {
        "psr-4": {
            "Phibble\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Expr/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Phibble\\Bench\\": "bench/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5.10"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Phibble\\Laravel\\PhibbleServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/erikwestlund/phit"
        }
    ]
}
